# TimePulse server configuratie
# Kopieer dit bestand naar .env en vul de waarden in

# Poort waarop de server draait
PORT=3456

# Harvest Personal Access Token
# Aanmaken via: https://id.getharvest.com/developers
HARVEST_ACCESS_TOKEN=your_personal_access_token_here

# Harvest Account ID
# Te vinden in: Harvest > Settings > API
HARVEST_ACCOUNT_ID=your_account_id_here

# Pad naar de SQLite database
DB_PATH=./data/timepulse.db

# Logo.dev API token (gratis: 500.000 requests/maand)
# Aanmaken via: https://www.logo.dev
LOGO_DEV_TOKEN=pk_your_token_here
