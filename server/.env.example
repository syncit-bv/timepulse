# TimePulse server configuratie
# Kopieer naar .env en vul in

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3456
PUBLIC_URL=https://jouw-app.onrender.com

# ── Supabase ──────────────────────────────────────────────────────────────────
# Aanmaken via: https://supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=jouw-jwt-secret-hier

# PostgreSQL (Supabase → Project Settings → Database → Connection string → Transaction pooler)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:wachtwoord@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ── Harvest OAuth2 ────────────────────────────────────────────────────────────
# OAuth2 app aanmaken via: https://id.getharvest.com/developers
HARVEST_CLIENT_ID=jouw_client_id
HARVEST_CLIENT_SECRET=jouw_client_secret
HARVEST_REDIRECT_URI=https://jouw-app.onrender.com/auth/harvest/callback

# ── Logo.dev ──────────────────────────────────────────────────────────────────
# Aanmaken via: https://www.logo.dev
LOGO_DEV_TOKEN=pk_jouw_token_hier
